# USM 账号与密码
USM_USERNAME=your_student_email@student.usm.my
USM_PASSWORD=your_usm_password

# Gemini AI 配置
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Telegram 推送配置
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Google Calendar 配置 (可选，留空或将 service_account.json 放于 data/ 目录)
GOOGLE_CALENDAR_ID=your_google_calendar_id@group.calendar.google.com
